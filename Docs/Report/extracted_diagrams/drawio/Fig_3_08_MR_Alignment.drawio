ell><mxCell id="dec_25" value="&lt;b&gt;if (HasPlacedPreview &amp;amp;&amp;amp; !Grip &amp;amp;&amp;amp; Press A?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Visitor confirms entrance sign alignment&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="795" width="320" height="95" as="geometry" /></mxCell><mxCell id="edge_26" value="[FALSE] Released" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#475569;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_20" target="dec_25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_27" value="[FALSE] Still aligning" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#475569;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_25" target="act_18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="842" /><mxPoint x="1040" y="582" /></Array></mxGeometry></mxCell><mxCell id="act_28" value="&lt;b&gt;StartCoroutine: ConfirmAlignment()&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;IsBusy = true&lt;/code&gt;&lt;br&gt;&lt;code&gt;Prompt UI: &amp;#x27;Creating spatial anchor...&amp;#x27;&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="930" width="300" height="75" as="geometry" /></mxCell><mxCell id="edge_29" value="[TRUE] A pressed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_25" target="act_28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="async_30" value="&lt;b&gt;⚙️ Meta XR Core SDK&lt;/b&gt;&lt;br&gt;&lt;font color='#1e3a8a' size='2'&gt;&lt;code&gt;OVRSpatialAnchor.CreateAsync() at aligned pose&lt;/code&gt;&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.05;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#1e3a8a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="1045" width="300" height="75" as="geometry" /></mxCell><mxCell id="edge_31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_28" target="async_30"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec_32" value="&lt;b&gt;if (anchor.Created &amp;amp;&amp;amp; Localized?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Check within 15s deadline&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="1160" width="280" height="90" as="geometry" /></mxCell><mxCell id="edge_33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="async_30" target="dec_32"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_34" value="&lt;b&gt;Anchor Creation Failed&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Prompt UI: &amp;#x27;Anchor localization failed. Retry.&amp;#x27;&lt;/code&gt;&lt;br&gt;&lt;code&gt;IsBusy = false&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="1160" width="300" height="80" as="geometry" /></mxCell><mxCell id="edge_35" value="[FALSE] Failed / Timeout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#dc2626;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_32" target="act_34"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_34" target="act_18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1520" y="1200" /><mxPoint x="1520" y="582" /><mxPoint x="960" y="582" /></Array></mxGeometry></mxCell><mxCell id="act_37" value="&lt;b&gt;Lock Reference Frame &amp;amp; Spawn Site&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;IsConfirmed = true, IsBusy = false&lt;/code&gt;&lt;br&gt;&lt;code&gt;Lock reference root pose to anchor&lt;/code&gt;&lt;br&gt;&lt;code&gt;Trigger MRModelSpawner.SpawnAlignedModel()&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="1290" width="320" height="85" as="geometry" /></mxCell><mxCell id="edge_38" value="[TRUE] Localized" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;e