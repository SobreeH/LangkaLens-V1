<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="fig-3-8" name="Fig 3.8 - MR Alignment"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title_2" value="&lt;b&gt;Figure 3.8. Programmatic Flowchart: On-Site Mixed Reality Entrance Alignment &amp;amp; Spatial Anchoring&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=20;fontColor=#0f172a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="15" width="1200" height="40" as="geometry" /></mxCell><mxCell id="start_3" value="&lt;b&gt;Enter On-Site MR Scene&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="220" height="55" as="geometry" /></mxCell><mxCell id="dec_4" value="&lt;b&gt;if (HeadIsTracked() &amp;amp;&amp;amp; ControllerTracked()?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Verify Meta Quest 6DOF tracking&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="155" width="300" height="95" as="geometry" /></mxCell><mxCell id="edge_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="start_3" target="dec_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_6" value="&lt;b&gt;Wait for Quest Tracking Readiness&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Display tracking &amp;amp; passthrough prompt&lt;/code&gt;&lt;br&gt;&lt;code&gt;Yield until 6DOF poses become valid&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="165" width="300" height="75" as="geometry" /></mxCell><mxCell id="edge_7" value="[FALSE] Untracked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#dc2626;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_4" target="act_6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_6" target="dec_4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1310" y="115" /><mxPoint x="810" y="115" /></Array></mxGeometry></mxCell><mxCell id="dec_9" value="&lt;b&gt;if (OVRInput: Left X held &amp;gt;= 2.0s?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Check for manual alignment reset&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="285" width="280" height="90" as="geometry" /></mxCell><mxCell id="edge_10" value="[TRUE] Tracked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_4" target="dec_9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_11" value="&lt;b&gt;Reset Session Anchor&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Destroy active anchorObject&lt;/code&gt;&lt;br&gt;&lt;code&gt;IsConfirmed = false; HasPlacedPreview = false&lt;/code&gt;&lt;br&gt;&lt;code&gt;BeginAlignment()&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="285" width="320" height="90" as="geometry" /></mxCell><mxCell id="edge_12" value="[TRUE] Reset held" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#dc2626;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_9" target="act_11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec_13" value="&lt;b&gt;if (IsConfirmed || IsBusy?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Is entrance alignment already locked?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="415" width="280" height="90" as="geometry" /></mxCell><mxCell id="edge_14" value="[FALSE] Normal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_9" target="dec_13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=