<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="fig-3-10" name="Fig 3.10 - Shared AI Workflow"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title_2" value="&lt;b&gt;Figure 3.10. Programmatic Flowchart: Multimodal Shared AI Heritage Guide Workflow&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=20;fontColor=#0f172a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="15" width="1200" height="40" as="geometry" /></mxCell><mxCell id="event_3" value="&lt;b&gt;⚡ Visitor opens AI Guide Canvas&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Tablet button or quick-action icon&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=15;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="300" height="65" as="geometry" /></mxCell><mxCell id="dec_4" value="&lt;b&gt;if (Visitor selects input method?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Speak button (Voice) vs Virtual Keyboard (Text)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="165" width="340" height="95" as="geometry" /></mxCell><mxCell id="edge_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="event_3" target="dec_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec_6" value="&lt;b&gt;if (IsRecording == true?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Toggle speech recording&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="295" width="280" height="90" as="geometry" /></mxCell><mxCell id="edge_7" value="[VOICE] Speak button" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#1d4ed8;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_4" target="dec_6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_8" value="&lt;b&gt;Stop Recording &amp;amp; Process&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Encode microphone samples to WAV&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="420" width="260" height="75" as="geometry" /></mxCell><mxCell id="edge_9" value="[TRUE] Active -&gt; Stop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#b45309;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_6" target="act_8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec_10" value="&lt;b&gt;if (RECORD_AUDIO Permission Granted?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Android microphone runtime permission&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="420" width="280" height="90" as="geometry" /></mxCell><mxCell id="edge_11" value="[FALSE] Start new" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_6" target="dec_10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_12" value="&lt;b&gt;Request Microphone Permission&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Permission.RequestUserPermission()&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="425" width="260" height="75" as="geometry" /></mxCell><mxCell id="edge_13" value="[FALSE] Denied" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#dc2626;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_10" target="act_12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_14" value="&lt;b&gt;Start Microphone Recording&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Microphone.Start(deviceName, loop=false, 15s, 16000)&lt;/code&gt;&lt;br&gt;&lt;code&gt;Show pulsing recording waveform indicator&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="550" width="300" height="80" as="geometry" /></mxCell><mxCell id="edge_15" value="[TRUE] Granted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_10" target="act_14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_16" value="&lt;b&gt;Encode Audio to 16kHz WAV&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Convert float audio samples to 16-bit PCM WAV&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="665" width="300" height="75" as="geometry" /></mxCell><mxCell id="edge_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_8" target="act_16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_14" target="act_16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="async_19" value="&lt;b&gt;⚙️ Groq Cloud Whisper API&lt;/b&gt;&lt;br&gt;&lt;font color='#1e3a8a' size='2'&gt;&lt;code&gt;POST /v1/audio/transcriptions (whisper-large-v3)&lt;/code&gt;&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.05;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#1e3a8a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="775" width="300" height="75" as="geometry" /></mxCell><mxCell id="edge_20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_16" target="async_19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec_21" value="&lt;b&gt;if (Groq HTTP Status == 200 OK?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Check transcription API response&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="890" width="280" height="90" as="geometry" /></mxCell><mxCell id="edge_22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="async_19" target="dec_21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="term_23" value="&lt;b&gt;Show Error Toast (Retry)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#991b1b;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="180" height="50" as="geometry" /></mxCell><mxCell id="edge_24" value="[FALSE] Error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#dc2626;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_21" target="term_23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_25" value="&lt;b&gt;Populate Input Field&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;inputField.text = transcriptionResult&lt;/code&gt;&lt;br&gt;&lt;code&gt;Enable visitor editing and correction&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="1020" width="300" height="80" as="geometry" /></mxCell><mxCell id="edge_26" value="[TRUE] Success" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_21" target="act_25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_27" value="&lt;b&gt;Bilingual Virtual Keyboard&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Click inputField -&amp;gt; open virtual keyboard&lt;/code&gt;&lt;br&gt;&lt;code&gt;Visitor types question in Thai or English&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1150" y="295" width="300" height="80" as="geometry" /></mxCell><mxCell id="edge_28" value="[TYPED] Keyboard" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#475569;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_4" target="act_27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_29" value="&lt;b&gt;Review &amp;amp; Edit Question&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Visitor reviews text in inputField before submitting&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="1025" width="300" height="70" as="geometry" /></mxCell><mxCell id="edge_30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_25" target="act_29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_27" target="act_29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="1060" /></Array></mxGeometry></mxCell><mxCell id="event_32" value="&lt;b&gt;⚡ Visitor clicks &amp;#x27;Send&amp;#x27; button&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;GeminiChatUI.OnSendClicked()&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=15;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="1130" width="300" height="65" as="geometry" /></mxCell><mxCell id="edge_33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_29" target="event_32"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec_34" value="&lt;b&gt;if (string.IsNullOrWhiteSpace(text)?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Check question is not blank&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="1230" width="300" height="85" as="geometry" /></mxCell><mxCell id="edge_35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="event_32" target="dec_34"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="term_36" value="&lt;b&gt;Ignore Click (Blank)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#991b1b;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="1247" width="190" height="50" as="geometry" /></mxCell><mxCell id="edge_37" value="[TRUE] Empty" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#dc2626;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_34" target="term_36"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec_38" value="&lt;b&gt;if (requestPending == true?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Is another query currently running?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="1350" width="300" height="85" as="geometry" /></mxCell><mxCell id="edge_39" value="[FALSE] Valid text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_34" target="dec_38"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_40" value="&lt;b&gt;Cancel In-Flight Request&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;currentWebRequest.Abort()&lt;/code&gt;&lt;br&gt;&lt;code&gt;Reset Send button icon; requestPending = false&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="1350" width="320" height="80" as="geometry" /></mxCell><mxCell id="edge_41" value="[TRUE] Stop requested" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#b45309;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_38" target="act_40"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_42" value="&lt;b&gt;Construct Prompt &amp;amp; Payload&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Append question to chat log (Cyan badge)&lt;/code&gt;&lt;br&gt;&lt;code&gt;Detect locale -&amp;gt; Select thaiSystemPrompt or English&lt;/code&gt;&lt;br&gt;&lt;code&gt;Build JSON: { contents, generationConfig: { maxOutputTokens } }&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="1475" width="360" height="90" as="geometry" /></mxCell><mxCell id="edge_43" value="[FALSE] Idle -&gt; Send" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_38" target="act_42"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="async_44" value="&lt;b&gt;⚙️ Google Gemini API&lt;/b&gt;&lt;br&gt;&lt;font color='#1e3a8a' size='2'&gt;&lt;code&gt;POST gemini-3.5-flash-lite:generateContent&lt;/code&gt;&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.05;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#1e3a8a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="1605" width="340" height="75" as="geometry" /></mxCell><mxCell id="edge_45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_42" target="async_44"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec_46" value="&lt;b&gt;if (request.result == Success (200)?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Check Gemini HTTP response&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="1720" width="340" height="90" as="geometry" /></mxCell><mxCell id="edge_47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="async_44" target="dec_46"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec_48" value="&lt;b&gt;if (enableFallback &amp;amp;&amp;amp; !usingFallback?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;HTTP 404, 408, 429, or 5xx error?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="1720" width="320" height="90" as="geometry" /></mxCell><mxCell id="edge_49" value="[FALSE] API Error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#dc2626;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_46" target="dec_48"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="async_50" value="&lt;b&gt;⚙️ Gemini Fallback Model&lt;/b&gt;&lt;br&gt;&lt;font color='#1e3a8a' size='2'&gt;&lt;code&gt;Retry POST gemini-3.1-flash-lite&lt;/code&gt;&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.05;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#1e3a8a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="1850" width="320" height="75" as="geometry" /></mxCell><mxCell id="edge_51" value="[TRUE] Fallback enabled" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#1d4ed8;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_48" target="async_50"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_52" value="&lt;b&gt;Display Localized Error&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Show error badge in chat log + &amp;#x27;Check Connection&amp;#x27;&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1850" width="200" height="75" as="geometry" /></mxCell><mxCell id="edge_53" value="[FALSE] Fallback off" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#dc2626;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_48" target="act_52"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_54" value="&