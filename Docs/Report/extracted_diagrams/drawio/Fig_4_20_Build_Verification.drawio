<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="fig-4-20" name="Fig 4.20 - Build &amp; Verification"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title_2" value="&lt;b&gt;Build and verification sequence for a reproducible educational project&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=18;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="200" y="5" width="1200" height="30" as="geometry" /></mxCell><mxCell id="node_3" value="&lt;b&gt;1  Check scene connections&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Four build scenes, Inspector references&lt;br&gt;Localization and content assets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f0f5f7;strokeColor=#607580;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#243541;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="35" width="700" height="150" as="geometry" /></mxCell><mxCell id="node_4" value="&lt;b&gt;2  Build Addressables&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Android target and configured profile&lt;br&gt;Photographs and reconstruction prefabs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f0f5f7;strokeColor=#607580;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#243541;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="35" width="700" height="150" as="geometry" /></mxCell><mxCell id="node_5" value="&lt;b&gt;3  Build the application&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Android APK&lt;br&gt;Project XR and player settings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f0f5f7;strokeColor=#607580;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#243541;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="315" width="700" height="160" as="geometry" /></mxCell><mxCell id="node_6" value="&lt;b&gt;4  Install on Quest&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Unity deployment or MQDH&lt;br&gt;Launch and check device logs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f0f5f7;strokeColor=#607580;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#243541;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="315" width="700" height="160" as="geometry" /></mxCell><mxCell id="node_7" value="&lt;b&gt;5  Verify the experience&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Language, navigation and inspection&lt;br&gt;On-site MR alignment and recovery&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f0f5f7;strokeColor=#607580;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#243541;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="700" height="145" as="geometry" /></mxCell><mxCell id="node_8" value="&lt;b&gt;6  Archive the reproduction&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Project revision, assets and versions&lt;br&gt;Build details and recorded test results&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f0f5f7;strokeColor=#607580;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#243541;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="610" width="700" height="145" as="geometry" /></mxCell><mxCell id="edge_9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607580;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="110" as="sourcePoint" /><mxPoint x="860" y="110" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607580;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1210" y="185" as="sourcePoint" /><mxPoint x="1210" y="315" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607580;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="395" as="sourcePoint" /><mxPoint x="740" y="395" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607580;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="475" as="sourcePoint" /><mxPoint x="390" y="610" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607580;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="680" as="sourcePoint" /><mxPoint x="860" y="680" as="targetPoint" /></mxGeometry></mxCell><mxCell id="div_14" value="" style="edgeStyle=none;html=1;strokeColor=#c5d0d6;strokeWidth=2;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="795" as="sourcePoint" /><mxPoint x="1560" y="795" as="targetPoint" /></mxGeometry></mxCell><mxCell id="note_15" value="• Use Section 4.5 to record functional results for the installed build." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=12;fontColor=#243541;" vertex="1" parent="1"><mxGeometry x="45" y="814" width="1500" height="30" as="geometry" /></mxCell><mxCell id="note_16" value="• Preserve .meta files and package locks; omit service secrets from shared archives." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=12;fontColor=#243541;" vertex="1" parent="1"><mxGeometry x="45" y="850" width="1500" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>