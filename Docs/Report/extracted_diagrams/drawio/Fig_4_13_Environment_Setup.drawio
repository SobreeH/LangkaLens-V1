<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="fig-4-13" name="Fig 4.13 - Environment &amp; Setup"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title_2" value="&lt;b&gt;Development environment and project restoration sequence&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=18;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="200" y="5" width="1200" height="30" as="geometry" /></mxCell><mxCell id="node_3" value="&lt;b&gt;1  Install the editor&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Unity 6000.3.16f1&lt;br&gt;Android SDK, NDK and OpenJDK&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f0f5f7;strokeColor=#607580;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#243541;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="700" height="160" as="geometry" /></mxCell><mxCell id="node_4" value="&lt;b&gt;2  Restore project files&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Assets + .meta files&lt;br&gt;Packages + ProjectSettings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f0f5f7;strokeColor=#607580;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#243541;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="40" width="700" height="160" as="geometry" /></mxCell><mxCell id="node_5" value="&lt;b&gt;3  Resolve packages&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Meta XR + URP + OpenXR&lt;br&gt;Input + UI + Localization + Addressables&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f0f5f7;strokeColor=#607580;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#243541;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="300" width="700" height="170" as="geometry" /></mxCell><mxCell id="node_6" value="&lt;b&gt;4  Configure Android&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;IL2CPP / ARM64&lt;br&gt;XR loader and feature settings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f0f5f7;strokeColor=#607580;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#243541;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="700" height="170" as="geometry" /></mxCell><mxCell id="node_7" value="&lt;b&gt;5  Register four scenes&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Main Menu first, then MR, Tour, Museum&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f0f5f7;strokeColor=#607580;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#243541;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="700" height="150" as="geometry" /></mxCell><mxCell id="node_8" value="&lt;b&gt;6  Verify on headset&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Build content and APK&lt;br&gt;Install, launch and record results&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f0f5f7;strokeColor=#607580;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#243541;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="590" width="700" height="150" as="geometry" /></mxCell><mxCell id="edge_9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607580;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="120" as="sourcePoint" /><mxPoint x="860" y="120" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607580;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1210" y="200" as="sourcePoint" /><mxPoint x="1210" y="300" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607580;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="385" as="sourcePoint" /><mxPoint x="740" y="385" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607580;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="470" as="sourcePoint" /><mxPoint x="390" y="590" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607580;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="665" as="sourcePoint" /><mxPoint x="860" y="665" as="targetPoint" /></mxGeometry></mxCell><mxCell id="div_14" value="" style="edgeStyle=none;html=1;strokeColor=#c5d0d6;strokeWidth=2;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="795" as="sourcePoint" /><mxPoint x="1560" y="795" as="targetPoint" /></mxGeometry></mxCell><mxCell id="note_15" value="• Follow the numbered sequence when reproducing the saved project." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=12;fontColor=#243541;" vertex="1" parent="1"><mxGeometry x="45" y="814" width="1500" height="30" as="geometry" /></mxCell><mxCell id="note_16" value="• Use the package lockfile to preserv