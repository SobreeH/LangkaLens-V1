<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="fig-3-4" name="Fig 3.4 - Main Menu Workflow"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title_2" value="&lt;b&gt;Figure 3.4. Programmatic Flowchart: Main Menu Language Confirmation &amp;amp; Scene Loading&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=20;fontColor=#0f172a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="15" width="1200" height="40" as="geometry" /></mxCell><mxCell id="start_3" value="&lt;b&gt;Application Launch&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="70" width="220" height="55" as="geometry" /></mxCell><mxCell id="act_4" value="&lt;b&gt;Initialize Main Menu&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;LocalizationSettings.InitializationOperation&lt;/code&gt;&lt;br&gt;&lt;code&gt;MainMenuManager.Awake()&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="160" width="280" height="70" as="geometry" /></mxCell><mxCell id="edge_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="start_3" target="act_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec_6" value="&lt;b&gt;if (Session HasSelectedLanguage?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Checks if visitor already confirmed&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="270" width="260" height="90" as="geometry" /></mxCell><mxCell id="edge_7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_4" target="dec_6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_8" value="&lt;b&gt;Show Language Modal Panel&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;languagePanel.SetActive(true)&lt;/code&gt;&lt;br&gt;&lt;code&gt;Hide mode buttons&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="280" width="260" height="70" as="geometry" /></mxCell><mxCell id="edge_9" value="[FALSE] First time" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#b45309;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_6" target="act_8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="event_10" value="&lt;b&gt;⚡ Visitor clicks &amp;#x27;Thai&amp;#x27; or &amp;#x27;English&amp;#x27;&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;SelectLanguage(index)&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=15;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=