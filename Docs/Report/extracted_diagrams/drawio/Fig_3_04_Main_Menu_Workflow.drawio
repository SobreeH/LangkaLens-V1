#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_16" target="act_18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="event_21" value="&lt;b&gt;⚡ Visitor clicks Mode Button&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Tour / Museum / MR&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=15;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="835" width="260" height="70" as="geometry" /></mxCell><mxCell id="edge_22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_18" target="event_21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec_23" value="&lt;b&gt;if (SceneLoadingScreen.IsLoading?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Guard against double-clicks&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="945" width="260" height="90" as="geometry" /></mxCell><mxCell id="edge_24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="event_21" target="dec_23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="term_25" value="&lt;b&gt;Ignore Click (Return)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#991b1b;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1050" y="965" width="180" height="50" as="geometry" /></mxCell><mxCell id="edge_26" value="[TRUE] Busy loading" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#dc2626;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_23" target="term_25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_27" value="&lt;b&gt;Begin Asynchronous Scene Load&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;SceneLoadingScreen.BeginContentLoading()&lt;/code&gt;&lt;br&gt;&lt;code&gt;Fade screen &amp;amp; show spinner&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="1080" width="300" height="75" as="geometry" /></mxCell><mxCell id="edge_28" value="[FALSE] Idle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_23" target="act_27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="async_29" value="&lt;b&gt;⚙️ Unity SceneManager&lt;/b&gt;&lt;br&gt;&lt;font color='#1e3a8a' size='2'&gt;&lt;code&gt;SceneManager.LoadSceneAsync(destSceneName)&lt;/code&gt;&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.05;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#1e3a8a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="1195" width="300" height="75" as="geometry" /></mxCell><mxCell id="edge_30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_27" target="async_29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="start_31" value="&lt;b&gt;Enter Destination Mode Scene&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="1310" width="220" height="55" as="geometry" /></mxCell><mxCell id="edge_32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="async_29" target="start_31"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>