<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="fig-4-18" name="Fig 4.18 - MR Alignment Dependencies"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title_2" value="&lt;b&gt;MR alignment, session anchoring and reconstruction-display dependencies&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=18;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="200" y="5" width="1200" height="30" as="geometry" /></mxCell><mxCell id="node_3" value="&lt;b&gt;Authored site reference&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Entrance sign/table mesh&lt;br&gt;Tracked controller and head references&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f0f5f7;strokeColor=#607580;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#243541;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="35" width="700" height="160" as="geometry" /></mxCell><mxCell id="node_4" value="&lt;b&gt;MRMeshReferenceAlignment&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Place outline with grip and stick&lt;br&gt;Release grip, then confirm with A&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f0f5f7;strokeColor=#607580;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#243541;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="35" width="700" height="160" as="geometry" /></mxCell><mxCell id="node_5" value="&lt;b&gt;Session spatial anchor&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Created + localized + tracked&lt;br&gt;Retry alignment if setup fails&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f0f5