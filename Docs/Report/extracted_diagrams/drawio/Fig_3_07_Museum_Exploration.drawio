<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="fig-3-7" name="Fig 3.7 - Museum Exploration"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title_2" value="&lt;b&gt;Figure 3.7. Programmatic Flowchart: VR Museum Exploration, Dimmer Fade &amp;amp; Artifact Inspection&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=20;fontColor=#0f172a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="15" width="1200" height="40" as="geometry" /></mxCell><mxCell id="event_3" value="&lt;b&gt;⚡ Visitor points ray &amp;amp; pulls Trigger / Pinch&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Raycast hits Artifact pedestal collider&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=15;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="70" width="340" height="70" as="geometry" /></mxCell><mxCell id="dec_4" value="&lt;b&gt;if (IsInspecting || IsMoving?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Checks if museum inspection is active&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="180" width="320" height="95" as="geometry" /></mxCell><mxCell id="edge_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="event_3" target="dec_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="term_6" value="&lt;b&gt;Ignore Raycast (Return)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#991b1b;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="202" width="190" height="50" as="geometry" /></mxCell><mxCell id="edge_7" value="[TRUE] Busy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#dc2626;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_4" target="term_6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec_8" value="&lt;b&gt;if (artifact.GetComponent&amp;lt;ArtifactData&amp;gt;() != null?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Check valid museum artifact station&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="315" width="360" height="95" as="geometry" /></mxCell><mxCell id="edge_9" value="[FALSE] Idle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_4" target="dec_8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="term_10" value="&lt;b&gt;Ignore (Not an artifact)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#991b1b;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="337" width="190" height="50" as="geometry" /></mxCell><mxCell id="edge_11" value="[FALSE] Missing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#dc2626;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_8" target="term_10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_12" value="&lt;b&gt;Begin Inspection State&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;IsInspecting = true; Pause locomotion&lt;/code&gt;&lt;br&gt;&lt;code&gt;Capture original artifact &amp;amp; player rig transform&lt;/code&gt;&lt;br&gt;&lt;code&gt;Hide pedestal &amp;amp; info icon GameObject&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="450" width="360" height="85" as="geometry" /></mxCell><mxCell id="edge_13" value="[TRUE] Valid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_8" target="act_12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_14" value="&lt;b&gt;Trigger EnvironmentDimmer&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;EnvironmentDimmer.Begin(brightness = 0.18, duration = 0.35s)&lt;/code&gt;&lt;br&gt;&lt;code&gt;Fade museum gallery materials to dark backdrop&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="570" width="360" height="80" as="geometry" /></mxCell><mxCell id="edge_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_12" target="act_14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_16" value="&lt;b&gt;Bring Artifact to Inspection Distance&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Smoothly glide model to eye distance (0.6m)&lt;/code&gt;&lt;br&gt;&lt;code&gt;Attach OneGrabFreeRotateTransformer &amp;amp; Zoom (0.5x - 3.0x)&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="685" width="360" height="80" as="geometry" /></mxCell><mxCell id="edge_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_14" target="act_16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_18" value="&lt;b&gt;Open Inspection Canvas Tablet&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Bind LocalizedString title &amp;amp; description&lt;/code&gt;&lt;br&gt;&lt;code&gt;Reset scroll rect position&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="800" width="340" height="75" as="geometry" /></mxCell><mxCell id="edge_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_16" target="act_18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec_20" value="&lt;b&gt;if (currentArtifactData.alternateModel != null?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Has alternate / reconstructed form?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="915" width="360" height="95" as="geometry" /></mxCell><mxCell id="edge_21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_18" target="dec_20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_22" value="&lt;b&gt;Show &amp;#x27;Switch Form&amp;#x27; Button&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;toggleModelButton.SetActive(true)&lt;/code&gt;&lt;br&gt;&lt;code&gt;Bind modelStateLocalizeEvent&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="920" width="300" height="80" as="geometry" /></mxCell><mxCell id="edge_23" value="[TRUE] Has alternate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_20" target="act_22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="event_24" value="&lt;b&gt;⚡ Visitor clicks &amp;#x27;Switch Form&amp;#x27;&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Swap between Original and Reconstructed mesh&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=15;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="1035" width="300" height="70" as="geometry" /></mxCell><mxCell id="edge_25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_22" target="event_24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_26" value="&lt;b&gt;Hide &amp;#x27;Switch Form&amp;#x27; Button&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;toggleModelButton.SetActive(false)&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="1040" width="300" height="65" as="geometry" /></mxCell><mxCell id="edge_27" value="[FALSE] Single model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#475569;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_20" target="act_26"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_28" value="&lt;b&gt;Active Museum Inspection Loop&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Visitor manipulates 3D artifact with hand grab&lt;/code&gt;&lt;br&gt;&lt;code&gt;Joystick zoom in/out, reads bilingual info panel&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1140" width="360" height="80" as="geometry" /></mxCell><mxCell id="edge_29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="event_24" target="act_28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_26" target="act_28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="event_31" value="&lt;b&gt;⚡ Visitor clicks &amp;#x27;Close&amp;#x27; / presses B button&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Exit inspection command&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=15;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="1255" width="300" height="65" as="geometry" /></mxCell><mxCell id="edge_32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_28" target="event_31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_33" value="&lt;b&gt;Teardown &amp;amp; Environment Restoration&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;EnvironmentDimmer.Restore() -&amp;gt; Fade gallery back to 1.0&lt;/code&gt;&lt;br&gt;&lt;code&gt;Glide artifact back to pedestal &amp;amp; restore rotation&lt;/code&gt;&lt;br&gt;&lt;code&gt;Re-enable visitor locomotion; IsInspecting = false&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="1355" width="380" height="90" as="geometry" /></mxCell><mxCell id="edge_34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="event_31" target="act_33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="start_35" value="&lt;b&gt;Resume Museum Exploration&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="1480" width="220" height="55" as="geometry" /></mxCell><mxCell id="edge_36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_33" target="start_35"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>