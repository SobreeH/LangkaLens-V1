geometry" /></mxCell><mxCell id="dec_16" value="&lt;b&gt;if (anchor.IsTracked &amp;amp;&amp;amp; Localized?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Check spatial anchor tracking state&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="435" width="320" height="90" as="geometry" /></mxCell><mxCell id="edge_17" value="[TRUE] Head tracked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_10" target="dec_16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_18" value="&lt;b&gt;Anchor Tracking Degraded&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Hide site models to prevent visual drifting&lt;/code&gt;&lt;br&gt;&lt;code&gt;Wait for anchor re-localization&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="435" width="320" height="80" as="geometry" /></mxCell><mxCell id="edge_19" value="[FALSE] Anchor lost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#dc2626;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_16" target="act_18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec_20" value="&lt;b&gt;if (PassthroughReady &amp;amp;&amp;amp; Active?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Ensure real world passthrough is rendered&l