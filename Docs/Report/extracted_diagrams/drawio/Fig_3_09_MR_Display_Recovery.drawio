<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="fig-3-9" name="Fig 3.9 - MR Display Recovery"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title_2" value="&lt;b&gt;Figure 3.9. Programmatic Flowchart: MR Reconstruction Display Gating &amp;amp; Tracking Recovery Loop&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=20;fontColor=#0f172a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="15" width="1200" height="40" as="geometry" /></mxCell><mxCell id="event_3" value="&lt;b&gt;⚡ Unity Update() Frame Tick&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;MRMeshPlayableArea / MRModelSpawner&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=15;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="70" width="340" height="65" as="geometry" /></mxCell><mxCell id="dec_4" value="&lt;b&gt;if (Alignment.IsConfirmed == true?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Has entrance alignment completed?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="175" width="320" height="90" as="geometry" /></mxCell><mxCell id="edge_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="event_3" target="dec_4"><mxGeometry relative="1" as="geometr