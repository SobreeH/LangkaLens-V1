<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="fig-3-5" name="Fig 3.5 - Tour Navigation"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title_2" value="&lt;b&gt;Figure 3.5. Programmatic Flowchart: 360-Degree Panoramic Tour Navigation &amp;amp; Viewpoint Transitions&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=20;fontColor=#0f172a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="15" width="1200" height="40" as="geometry" /></mxCell><mxCell id="event_3" value="&lt;b&gt;⚡ Visitor clicks NavigationArrow&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;LoadNode(targetNode, targetWorldPos)&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=15;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="70" width="300" height="70" as="geometry" /></mxCell><mxCell id="dec_4" value="&lt;b&gt;if (IsNavigationBlocked?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;IsTransitioning || IsReconstructionBusy || IsMapOpen&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="180" width="340" height="100" as="geometry" /></mxCell><mxCell id="edge_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="event_3" target="dec_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="term_6" value="&lt;b&gt;Ignore Click (No-Op)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#991b1b;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="205" width="190" height="50" as="geometry" /></mxCell><mxCell id="edge_7" value="[TRUE] Blocked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#dc2626;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_4" target="term_6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec_8" value="&lt;b&gt;if (photoReference.RuntimeKeyIsValid()?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Check Addressable key exists&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="320" width="320" height="95" as="geometry" /></mxCell><mxCell id="edge_9" value="[FALSE] Idle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_4" target="dec_8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="term_10" value="&lt;b&gt;Debug.LogError / Abort&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#991b1b;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="342" width="190" height="50" as="geometry" /></mxCell><mxCell id="edge_11" value="[FALSE] Invalid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#dc2626;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_8" target="term_10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_12" value="&lt;b&gt;Lock State &amp;amp; Hide Navigation UI&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;IsTransitioning = true&lt;/code&gt;&lt;br&gt;&lt;code&gt;Hide active arrows &amp;amp; clear hover icons&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="455" width="320" height="75" as="geometry" /></mxCell><mxCell id="edge_13" value="[TRUE] Valid key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_8" target="act_12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="async_14" value="&lt;b&gt;⚙️ Addressables Asset Pipeline&lt;/b&gt;&lt;br&gt;&lt;font color='#1e3a8a' size='2'&gt;&lt;code&gt;Addressables.LoadAssetAsync&amp;lt;Texture2D&amp;gt;(photoReference)&lt;/code&gt;&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.05;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#1e3a8a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="565" width="340" height="75" as="geometry" /></mxCell><mxCell id="edge_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_12" target="async_14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_16" value="&lt;b&gt;Start Warp Transition Animation&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Lunge rig forward by 3m (Ease-in)&lt;/code&gt;&lt;br&gt;&lt;code&gt;Stretch PhotoSphere container forward 3x&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="675" width="340" height="80" as="geometry" /></mxCell><mxCell id="edge_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="async_14" target="act_16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec_18" value="&lt;b&gt;if (handle.Status == Succeeded?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Within 30s load deadline&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="795" width="320" height="95" as="geometry" /></mxCell><mxCell id="edge_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_16" target="dec_18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_20" value="&lt;b&gt;Error Recovery: Rollback State&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Release pending handle&lt;/code&gt;&lt;br&gt;&lt;code&gt;Reset rig position &amp;amp; restore previous view&lt;/code&gt;&lt;br&gt;&lt;code&gt;IsTransitioning = false; RefreshNavigation()&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="795" width="320" height="95" as="geometry" /></mxCell><mxCell id="edge_21" value="[FALSE] Failed / Timeout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#dc2626;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_18" target="act_20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="term_22" value="&lt;b&gt;Keep Current Viewpoint&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#991b1b;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="940" width="220" height="50" as="geometry" /></mxCell><mxCell id="edge_23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_20" target="term_22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_24" value="&lt;b&gt;Apply Destination Panorama&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;photoSphereRenderer.material.mainTexture = handle.Result&lt;/code&gt;&lt;br&gt;&lt;code&gt;Release previous texture handle from GPU VRAM&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="930" width="340" height="80" as="geometry" /></mxCell><mxCell id="edge_25" value="[TRUE] Succeeded" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_18" target="act_24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_26" value="&lt;b&gt;Settle Rig &amp;amp; Update Tour State&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Ease-out rig to ideal center position&lt;/code&gt;&lt;br&gt;&lt;code&gt;Reset PhotoSphere container scale to 1.0&lt;/code&gt;&lt;br&gt;&lt;code&gt;currentNode = targetNode&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="1045" width="340" height="80" as="geometry" /></mxCell><mxCell id="edge_27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_24" target="act_26"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_28" value="&lt;b&gt;Spawn Navigation Arrows &amp;amp; Hints&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Instantiate ArrowPlacementHelper for connectedPaths&lt;/code&gt;&lt;br&gt;&lt;code&gt;Check currentNode reconstruction -&amp;gt; Enable Y hint&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="1160" width="340" height="80" as="geometry" /></mxCell><mxCell id="edge_29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_26" target="act_28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_30" value="&lt;b&gt;Unlock Navigation State&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;IsTransitioning = false&lt;/code&gt;&lt;br&gt;&lt;code&gt;Navigation input resumes&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="1275" width="260" height="65" as="geometry" /></mxCell><mxCell id="edge_31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_28" target="act_30"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="start_32" value="&lt;b&gt;Viewpoint Ready&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="1370" width="220" height="55" as="geometry" /></mxCell><mxCell id="edge_33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_30" target="start_32"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>