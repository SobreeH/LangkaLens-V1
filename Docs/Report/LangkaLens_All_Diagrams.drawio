amily=Arial;fontSize=14;fontColor=#243541;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="700" height="160" as="geometry" /></mxCell><mxCell id="node_4" value="&lt;b&gt;2  Restore project files&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Assets + .meta files&lt;br&gt;Packages + ProjectSettings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f0f5f7;strokeColor=#607580;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#243541;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="40" width="700" height="160" as="geometry" /></mxCell><mxCell id="node_5" value="&lt;b&gt;3  Resolve packages&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Meta XR + URP + OpenXR&lt;br&gt;Input + UI + Localization + Addressables&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f0f5f7;strokeColor=#607580;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#243541;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="300" width="700" height="170" as="geometry" /></mxCell><mxCell id="node_6" value="&lt;b&gt;4  Configure Android&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;IL2CPP / ARM64&lt;br&gt;XR loader and feature settings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f0f5f7;strokeColor=#607580;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#243541;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="700" height="170" as="geometry" /></mxCell><mxCell id="node_7" value="&lt;b&gt;5  Register four scenes&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Main Menu first, then MR, Tour, Museum&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f0f5f7;strokeColor=#607580;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#243541;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="700" height="150" as="geometry" /></mxCell><mxCell id="node_8" value="&lt;b&gt;6  Verify on headset&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Build content and APK&lt;br&gt;Install, launch and record results&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f0f5f7;strokeColor=#607580;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#243541;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="590" width="700" height="150" as="geometry" /></mxCell><mxCell id="edge_9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607580;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="120" as="sourcePoint" /><mxPoint x="860" y="120" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607580;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1210" y="200" as="sourcePoint" /><mxPoint x="1210" y="300" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607580;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="385" as="sourcePoint" /><mxPoint x="740" y="385" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607580;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="470" as="sourcePoint" /><mxPoint x="390" y="590" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounde