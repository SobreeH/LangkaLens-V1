E] Idle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_23" target="act_27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="async_29" value="&lt;b&gt;⚙️ Unity SceneManager&lt;/b&gt;&lt;br&gt;&lt;font color='#1e3a8a' size='2'&gt;&lt;code&gt;SceneManager.LoadSceneAsync(destSceneName)&lt;/code&gt;&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.05;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#1e3a8a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="1195" width="300" height="75" as="geometry" /></mxCell><mxCell id="edge_30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_27" target="async_29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="start_31" value="&lt;b&gt;Enter Destination Mode Scene&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="1310" width="220" height="55" as="geometry" /></mxCell><mxCell id="edge_32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="async_29" target="start_31"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="fig-3-5" name="Fig 3.5 - Tour Navigation"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageSc