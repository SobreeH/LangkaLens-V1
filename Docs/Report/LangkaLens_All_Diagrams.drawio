ur, Museum &amp;amp; MR buttons&lt;/code&gt;&lt;br&gt;&lt;code&gt;Show reusable user guide icon&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="725" width="280" height="70" as="geometry" /></mxCell><mxCell id="edge_19" value="[TRUE] Confirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_6" target="act_18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="420" /><mxPoint x="800" y="710" /></Array></mxGeometry></mxCell><mxCell id="edge_20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_16" target="act_18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="event_21" value="&lt;b&gt;⚡ Visitor clicks Mode Button&lt;/b&gt;&lt;br&gt;&lt;font color='#475569' size='2'&gt;Tour / Museum / MR&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=15;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="835" width="260" height="70" as="geometry" /></mxCell><mxCell id="edge_22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_18" target="event_21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec_23" value="&lt;b&gt;if (SceneLoadingScreen.IsLoading?)?