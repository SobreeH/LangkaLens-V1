ll><mxCell id="dec_9" value="&lt;b&gt;if (OVRInput: Left X held &amp;gt;= 2.0s?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Check for manual alignment reset&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="285" width="280" height="90" as="geometry" /></mxCell><mxCell id="edge_10" value="[TRUE] Tracked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_4" target="dec_9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_11" value="&lt;b&gt;Reset Session Anchor&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Destroy active anchorObject&lt;/code&gt;&lt;br&gt;&lt;code&gt;IsConfirmed = false; HasPlacedPreview = false&lt;/code&gt;&lt;br&gt;&lt;code&gt;BeginAlignment()&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="285" width="320" height="90" as="geometry" /></mxCell><mxCell id="edge_12" value="[TRUE] Reset held" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#dc2626;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_9" target="act_11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec_13" value="&lt;b&gt;if (IsConfirmed || IsBusy?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Is entrance alignment already locked?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="415" width="280" height="90" as="geometry" /></mxCell><mxCell id="edge_14" value="[FALSE] Normal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_9" target="dec_13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_11" target="dec_13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="460" /></Array></mxGeometry></mxCell><mxCell id="term_16" value="&lt;b&gt;Site Aligned (Proceed to Display)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#166534;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1160" y="435" width="240" height="50" as="geometry" /></mxCell><mxCell id="edge_17" value="[TRUE] Confirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_13" target="term_16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_18" value="&lt;b&gt;Display Entrance Wireframe Outline&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Show reference mesh attached to Right Controller&lt;/code&gt;&lt;br&gt;&lt;code&gt;PlacementReach = 0.6m&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="545" width="300" height="75" as="geometry" /></mxCell><mxCell id="edge_19" value="[FALSE] Unaligned" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#b45309;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_13" target="act_18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dec_20" value="&lt;b&gt;if (Right Hand Trigger Held?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Is visitor adjusting pose with grip?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="660" width="280" height="90" as="geometry" /></mxCell><mxCell id="edge_21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_18" target="dec_20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="act_22" value="&lt;b&gt;Adjust Alignment Pose&lt;/b&gt;&lt;br&gt;&lt;font color='#334155' size='2'&gt;&lt;code&gt;Thumbstick X: Rotate yaw (45 deg/s)&lt;/code&gt;&lt;br&gt;&lt;code&gt;Thumbstick Y: Adjust reach distance (0.15m - 3m)&lt;/code&gt;&lt;br&gt;&lt;code&gt;HasPlacedPreview = true&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="660" width="320" height="90" as="geometry" /></mxCell><mxCell id="edge_23" value="[TRUE] Grip held" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_20" target="act_22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="act_22" target="dec_20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="780" /><mxPoint x="810" y="780" /></Array></mxGeometry></mxCell><mxCell id="dec_25" value="&lt;b&gt;if (HasPlacedPreview &amp;amp;&amp;amp; !Grip &amp;amp;&amp;amp; Press A?)?&lt;/b&gt;&lt;br&gt;&lt;font color='#78350f' size='1'&gt;Visitor confirms entrance sign alignment&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#78350f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="795" width="320" height="95" as="geometry" /></mxCell><mxCell id="edge_26" value="[FALSE] Released" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#475569;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_20" target="dec_25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_27" value="[FALSE] Still aligning" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#475569;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=12;fontFamily=Arial;" edge="1" parent="1" source="dec_25