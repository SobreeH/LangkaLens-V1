  - m_Id: 692760577
    m_Localized: "\u0E01\u0E14 GRIP \u0E02\u0E27\u0E32\u0E04\u0E49\u0E32\u0E07\u0E44\u0E27\u0E49\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E27\u0E32\u0E07\u0E42\u0E04\u0E23\u0E07\u0E23\u0E48\u0E32\u0E07\u0E1B\u0E49\u0E32\u0E22/\u0E42\u0E15\u0E4A\u0E30"
