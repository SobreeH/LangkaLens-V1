      objectReference: {fileID: 821298515}
    - target: {fileID: 4594198701855715547, guid: b1be852542e7e1e41a6de73eaa215983, type: 3}
      propertyPath: artifactTitle
      value: 'Terracotta Miniature Stupa with Inverted-Bowl Dome '
      objectReference: {fileID: 0}
    - target: {fileID: 4594198701855715547, guid: b1be852542e7e1e41a6de73eaa215983, type: 3}
      propertyPath: alternateModel
      value: 
      objectReference: {fileID: 1837742467}
    - target: {fileID: 4594198701855715547, guid: b1be852542e7e1e41a6de73eaa215983, type: 3}
      propertyPath: artifactDescription
      value: "Dating / Period: 12th\u201314th centuries Buddhist Era (approx. 7th\u20139th
        centuries CE)\r\n\r\n\r\nMaterial: Fine-grained baked clay (Terracotta)\r\n\r\n\r\nDiscovery
        Location: Ban Wat / Ban Jaleh archaeological complex, Yarang Ancient City,
        Pattani Province\r\n\r\n\r\nDescription: A free-standing votive stupa (Sathup
        Din Phao) crafted as a sacred Buddhist offering. The structure rises from
        a circular stepped pedestal with a distinct recessed waist (thong mai). The
        central bell dome is sculpted into an inverted-bowl form (ong rakhang song
        o khwam). Rising directly from the dome is an integrated conical spire formed
        by concentric horizontal ring ridges (plong chanai), which tapers steadily
        toward a pointed lotus-bud finial (bua tum). Votive objects of this type
        were buried within brick sanctuary foundations to generate religious merit."
      objectReference: {fileID: 0}
    - target: {fileID: 4594198701855715547, guid: b1be852542e7e1e41a6de73eaa215983, type: 3}
      propertyPath: spatialToggleButtonAnchor
      value: 
      objectReference: {fileID: 519440290}
    - target: {fileID: 4594198701855715547, guid: b1be852542e7e1e41a6de73eaa215983, type: 3}
      propertyPath: localizedTitle.m_TableEntryReference.m_KeyId
      value: 291722586148864
      objectReference: {fileID: 0}
    - target: {fileID: 4594198701855715547, guid: b1be852542e7e1e41a6de73eaa215983, type: 3}
      propertyPath: localizedDescription.m_TableEntryReference.m_KeyId
