      | \u0E04\u0E27\u0E32\u0E21\u0E01\u0E27\u0E49\u0E32\u0E07: 16 \u0E0B\u0E21.
      | \u0E04\u0E27\u0E32\u0E21\u0E2B\u0E19\u0E32: 16 \u0E0B\u0E21.\n- \u0E2A\u0E16\u0E32\u0E19\u0E17\u0E35\u0E48\u0E04\u0E49\u0E19\u0E1E\u0E1A:
      \u0E1A\u0E23\u0E34\u0E40\u0E27\u0E13\u0E04\u0E39\u0E40\u0E21\u0E37\u0E2D\u0E07\u0E14\u0E49\u0E32\u0E19\u0E17\u0E34\u0E28\u0E15\u0E30\u0E27\u0E31\u0E19\u0E15\u0E01
      \u0E01\u0E25\u0E38\u0E48\u0E21\u0E42\u0E1A\u0E23\u0E32\u0E13\u0E2A\u0E16\u0E32\u0E19\u0E1A\u0E49\u0E32\u0E19\u0E1B\u0E23\u0E30\u0E41\u0E27
      \u0E2D\u0E33\u0E40\u0E20\u0E2D\u0E22\u0E30\u0E23\u0E31\u0E07 \u0E08\u0E31\u0E07\u0E2B\u0E27\u0E31\u0E14\u0E1B\u0E31\u0E15\u0E15\u0E32\u0E19\u0E35
      (\u0E1E\u0E1A\u0E40\u0E21\u0E37\u0E48\u0E2D \u0E1E.\u0E28. 2520)\n- \u0E2A\u0E16\u0E32\u0E19\u0E17\u0E35\u0E48\u0E40\u0E01\u0E47\u0E1A\u0E23\u0E31\u0E01\u0E29\u0E32\u0E1B\u0E31\u0E08\u0E08\u0E38\u0E1A\u0E31\u0E19:
      \u0E28\u0E39\u0E19\u0E22\u0E4C\u0E28\u0E34\u0E25\u0E1B\u0E27\u0E31\u0E12\u0E19\u0E18\u0E23\u0E23\u0E21
      \u0E21\u0E2B\u0E32\u0E27\u0E34\u0E17\u0E22\u0E32\u0E25\u0E31\u0E22\u0E23\u0E32\u0E0A\u0E20\u0E31\u0E0F\u0E22\u0E30\u0E25\u0E32\n\n\u0E04\u0E33\u0E2D\u0E18\u0E34\u0E1A\u0E32\u0E22\u0E17\u0E32\u0E07\u0E27\u0E34\u0E0A\u0E32\u0E01\u0E32\u0E23:\n\u0E1B\u0E23\u0E30\u0E15\u0E34\u0E21\u0E32\u0E01\u0E23\u0E23\u0E21\u0E2B\u0E34\u0E19\u0E17\u0E23\u0E32\u0E22\u0E0A\u0E34\u0E49\u0E19\u0E19\u0E35\u0E49\u0E40\u0E1B\u0E47\u0E19\u0E28\u0E34\u0E27\u0E25\u0E36\u0E07\u0E04\u0E4C\u0E15\u0E32\u0E21\u0E41\u0E1A\u0E1A\u0E41\u0E1C\u0E19\u0E14\u0E31\u0E49\u0E07\u0E40\u0E14\u0E34\u0E21
      (\u0E41\u0E1A\u0E1A\u0E1B\u0E23\u0E30\u0E40\u0E1E\u0E13\u0E35\u0E19\u0E34\u0E22\u0E21)
      \u0E17\u0E35\u0E48\u0E16\u0E39\u0E01\u0E2A\u0E25\u0E31\u0E01\u0E40\u0E1B\u0E47\u0E19\u0E2A\u0E32\u0E21\u0E2A\u0E48\u0E27\u0E19\u0E40\u0E17\u0E48\u0E32\u0E46
      \u0E01\u0E31\u0E19\u0E43\u0E19\u0E41\u0E19\u0E27\u0E15\u0E31\u0E49\u0E07 \u0E0B\u0E36\u0E48\u0E07\u0E40\u0E1B\u0E47\u0E19\u0E2A\u0E31\u0E0D\u0E25\u0E31\u0E01\u0E29\u0E13\u0E4C\u0E02\u0E2D\u0E07\u0E15\u0E23\u0E35\u0E21\u0E39\u0E23\u0E15\u0E34\u0E43\u0E19\u0E28\u0E32\u0E2A\u0E19\u0E32\u0E2E\u0E34\u0E19\u0E14\u0E39:\n\n-
      \u0E23\u0E38\u0E17\u0E23\u0E20\u0E32\u0E04 (\u0E2A\u0E48\u0E27\u0E19\u0E1A\u0E19):
      \u0E17\u0E23\u0E07\u0E01\u0E23\u0E30\u0E1A\u0E2D\u0E01\u0E21\u0E19\u0E23\u0E39\u0E1B\u0E44\u0E02\u0E48\u0E17\u0E35\u0E48\u0E40\u0E23\u0E35\u0E22\u0E1A\u0E40\u0E19\u0E35\u0E22\u0E19\u0E40\u0E1B\u0E47\u0E19\u0E15\u0E31\u0E27\u0E41\u0E17\u0E19\u0E02\u0E2D\u0E07\u0E1E\u0E23\u0E30\u0E28\u0E34\u0E27\u0E30
      \u0E21\u0E35\u0E01\u0E32\u0E23\u0E2A\u0E25\u0E31\u0E01\u0E40\u0E2A\u0E49\u0E19\u0E41\u0E01\u0E19\u0E01\u0E25\u0E32\u0E07\u0E41\u0E19\u0E27\u0E15\u0E31\u0E49\u0E07
      (\u0E1E\u0E23\u0E2B\u0E21\u0E2A\u0E39\u0E15\u0E23) \u0E41\u0E25\u0E30\u0E40\u0E2A\u0E49\u0E19\u0E02\u0E2D\u0E1A\u0E14\u0E49\u0E32\u0E19\u0E02\u0E49\u0E32\u0E07\u0E17\u0E35\u0E48\u0E42\u0E04\u0E49\u0E07\u0E44\u0E1B\u0E17\u0E32\u0E07\u0E14\u0E49\u0E32\u0E19\u0E2B\u0E25\u0E31\u0E07
      (\u0E1B\u0E32\u0E23\u0E28\u0E27\u0E2A\u0E39\u0E15\u0E23)\n- \u0E27\u0E34\u0E29\u0E13\u0E38\u0E20\u0E32\u0E04
      (\u0E2A\u0E48\u0E27\u0E19\u0E01\u0E25\u0E32\u0E07): \u0E41\u0E01\u0E19\u0E1B\u0E23\u0E34\u0E0B\u0E36\u0E21\u0E41\u0E1B\u0E14\u0E40\u0E2B\u0E25\u0E35\u0E48\u0E22\u0E21\u0E40\u0E1B\u0E47\u0E19\u0E15\u0E31\u0E27\u0E41\u0E17\u0E19\u0E02\u0E2D\u0E07\u0E1E\u0E23\u0E30\u0E27\u0E34\u0E29\u0E13\u0E38
      \u0E2D\u0E2D\u0E01\u0E41\u0E1A\u0E1A\u0E21\u0E32\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E1B\u0E23\u0E30\u0E14\u0E34\u0E29\u0E10\u0E32\u0E19\u0E25\u0E07\u0E43\u0E19\u0E10\u0E32\u0E19\u0E42\u0E22\u0E19\u0E34\u0E28\u0E31\u0E01\u0E14\u0E34\u0E4C\u0E2A\u0E34\u0E17\u0E18\u0E34\u0E4C\n-
      \u0E1E\u0E23\u0E2B\u0E21\u0E20\u0E32\u0E04 (\u0E2A\u0E48\u0E27\u0E19\u0E10\u0E32\u0E19):
      \u0E1A\u0E25\u0E47\u0E2D\u0E01\u0E1B\u0E23\u0E34\u0E0B\u0E36\u0E21\u0E2A\u0E35\u0E48\u0E40\u0E2B\u0E25\u0E35\u0E48\u0E22\u0E21\u0E40\u0E1B\u0E47\u0E19\u0E15\u0E31\u0E27\u0E41\u0E17\u0E19\u0E02\u0E2D\u0E07\u0E1E\u0E23\u0E30\u0E1E\u0E23\u0E2B\u0E21
      \u0E21\u0E35\u0E44\u0E27\u0E49\u0E2A\u0E33\u0E2B\u0E23\u0E31\u0E1A\u0E1D\u0E31\u0E07\u0E22\u0E36\u0E14\u0E40\u0E02\u0E49\u0E32\u0E01\u0E31\u0E1A\u0E23\u0E32\u0E01\u0E10\u0E32\u0E19\u0E02\u0E2D\u0E07\u0E28\u0E32\u0E2A\u0E19\u0E2A\u0E16\u0E32\u0E19\n\n\u0E01\u0E32\u0E23\u0E04\u0E49\u0E19\u0E1E\u0E1A\u0E42\u0E1A\u0E23\u0E32\u0E13\u0E27\u0E31\u0E15\u0E16\u0E38\u0E19\u0E35\u0E49\u0E43\u0E2B\u0E49\u0E2B\u0E25\u0E31\u0E01\u0E10\u0E32\u0E19\u0E17\u0E32\u0E07\u0E27\u0E31\u0E15\u0E16\u0E38\u0E17\u0E35\u0E48\u0E2A\u0E33\u0E04\u0E31\u0E0D\u0E40\u0E01\u0E35\u0E48\u0E22\u0E27\u0E01\u0E31\u0E1A\u0E01\u0E32\u0E23\u0E1A\u0E39\u0E0A\u0E32\u0E1E\u0E23\u0E30\u0E28\u0E34\u0E27\u0E30\u0E43\u0E19\u0E28\u0E32\u0E2A\u0E19\u0E32\u0E2E\u0E34\u0E19\u0E14\u0E39\u0E41\u0E25\u0E30\u0E27\u0E31\u0E12\u0E19\u0E18\u0E23\u0E23\u0E21\u0E17\u0E32\u0E07\u0E28\u0E32\u0E2A\u0E19\u0E32\u0E17\u0E35\u0E48\u0E1C\u0E2A\u0E21\u0E1C\u0E2A\u0E32\u0E19\u0E0B\u0E36\u0E48\u0E07\u0E40\u0E08\u0E23\u0E34\u0E0D\u0E23\u0E38\u0E48\u0E07\u0E40\u0E23\u0E37\u0E2D\u0E07\u0E04\u0E27\u0E1A\u0E04\u0E39\u0E48\u0E44\u0E1B\u0E01\u0E31\u0E1A\u0E1E\u0E38\u0E17\u0E18\u0E28\u0E32\u0E2A\u0E19\u0E32\u0E43\u0E19\u0E40\u0E21\u0E37\u0E2D\u0E07\u0E17\u0E48\u0E32\u0E42\u0E1A\u0E23\u0E32\u0E13\u0E22\u0E30\u0E23\u0E31\u0E07
      (\u0E25\u0E31\u0E07\u0E01\u0E32\u0E2A\u0E38\u0E01\u0E30)\n\n\u0E41\u0E2B\u0E25\u0E48\u0E07\u0E2D\u0E49\u0E32\u0E07\u0E2D\u0E34\u0E07\u0E41\u0E25\u0E30\u0E17\u0E35\u0E48\u0E21\u0E32\u0E02\u0E2D\u0E07\u0E42\u0E21\u0E40\u0E14\u0E25
      3 \u0E21\u0E34\u0E15\u0E34:\n\u2022 \u0E41\u0E2B\u0E25\u0E48\u0E07\u0E02\u0E49\u0E2D\u0E21\u0E39\u0E25\u0E2B\u0E25\u0E31\u0E01:
      \u0E2B\u0E19\u0E31\u0E07\u0E2A\u0E37\u0E2D \"\u0E40\u0E21\u0E37\u0E2D\u0E07\u0E42\u0E1A\u0E23\u0E32\u0E13\u0E22\u0E30\u0E23\u0E31\u0E07
      \u0E2D\u0E33\u0E40\u0E20\u0E2D\u0E22\u0E30\u0E23\u0E31\u0E07 \u0E08\u0E31\u0E07\u0E2B\u0E27\u0E31\u0E14\u0E1B\u0E31\u0E15\u0E15\u0E32\u0E19\u0E35\"
      (\u0E2A\u0E33\u0E19\u0E31\u0E01\u0E28\u0E34\u0E25\u0E1B\u0E32\u0E01\u0E23\u0E17\u0E35\u0E48
      \u0E51\u0E51 \u0E2A\u0E07\u0E02\u0E25\u0E32, \u0E52\u0E55\u0E56\u0E58), \u0E23\u0E32\u0E22\u0E01\u0E32\u0E23\u0E17\u0E35\u0E48
      \u0E52\u0E54\u2013\u0E52\u0E55, \u0E2B\u0E19\u0E49\u0E32 \u0E52\u0E55\u0E52\u2013\u0E52\u0E55\u0E53\n\u2022
      \u0E40\u0E2D\u0E01\u0E2A\u0E32\u0E23\u0E2D\u0E49\u0E32\u0E07\u0E2D\u0E34\u0E07\u0E23\u0E48\u0E27\u0E21:
      \u0E2B\u0E19\u0E31\u0E07\u0E2A\u0E37\u0E2D \"\u0E1E\u0E31\u0E12\u0E19\u0E32\u0E01\u0E32\u0E23\u0E17\u0E32\u0E07\u0E42\u0E1A\u0E23\u0E32\u0E13\u0E04\u0E14\u0E35\u0E41\u0E25\u0E30\u0E1B\u0E23\u0E30\u0E27\u0E31\u0E15\u0E34\u0E28\u0E32\u0E2A\u0E15\u0E23\u0E4C
      \u0E53 \u0E08\u0E31\u0E07\u0E2B\u0E27\u0E31\u0E14\u0E0A\u0E32\u0E22\u0E41\u0E14\u0E19\u0E43\u0E15\u0E49\"
      (\u0E2A\u0E32\u0E23\u0E31\u0E17 \u0E0A\u0E25\u0E2D\u0E2A\u0E31\u0E19\u0E15\u0E34\u0E2A\u0E01\u0E38\u0E25,
      \u0E52\u0E55\u0E56\u0E55), \u0E2B\u0E19\u0E49\u0E32 \u0E51\u0E57, \u0E57\u0E51,
      \u0E58\u0E50, \u0E51\u0E51\u0E56\n\u2022 \u0E42\u0E21\u0E40\u0E14\u0E25 3 \u0E21\u0E34\u0E15\u0E34:
      \u0E2A\u0E23\u0E49\u0E32\u0E07\u0E14\u0E49\u0E27\u0E22\u0E01\u0E23\u0E30\u0E1A\u0E27\u0E19\u0E01\u0E32\u0E23
      AI Image-to-3D \u0E08\u0E32\u0E01\u0E20\u0E32\u0E1E\u0E16\u0E48\u0E32\u0E22\u0E42\u0E1A\u0E23\u0E32\u0E13\u0E27\u0E31\u0E15\u0E16\u0E38\u0E08\u0E23\u0E34\u0E07\u0E43\u0E19\u0E40\u0E25\u0E48\u0E21"
