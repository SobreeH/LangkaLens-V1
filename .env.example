# Copy this file to .env (for Editor/desktop) or copy LangkaLensSecrets.example.json
# to Assets/Resources/LangkaLensSecrets.json (required so Unity bundles keys into Quest APK builds).
# Both .env and Assets/Resources/LangkaLensSecrets.json are gitignored.

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
ELEVENLABS_API_KEY=
DEV_AGENT_ACCESS_TOKEN=
